<div class="w-full px-4 py-6">
    <div class="flex justify-center mx-auto">
        <!-- Tabbed Interface - Full Width -->
        <div class="w-full">
            <div class="bg-gray-50 rounded-lg h-fit mx-4 my-6 shadow-sm">
                <!-- Tab Navigation -->
                <div class="flex border-b border-gray-200 rounded-t-lg overflow-hidden">
                    <button 
                        class="flex-1 py-3 px-4 text-sm font-medium text-center border-b-2 border-blue-500 text-blue-600 bg-white"
                        id="address-tab"
                        onclick="showTab('address')"
                    >
                        Enter an Address
                    </button>
                    <button 
                        class="flex-1 py-3 px-4 text-sm font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700 bg-gray-50"
                        id="browse-tab"
                        onclick="showTab('browse')"
                    >
                        Search & Browse
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="p-6">
                    <!-- Address Tab Content -->
                    <div id="address-content" class="tab-content">
                        <div class="space-y-4">
                            <div class="relative">
                                <h3><input
                                    type="text"
                                    id="address-input"
                                    name="address"
                                    placeholder="Enter your address (e.g., 123 Main St, City, State)"
                                    class="w-full py-3 px-4 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                    autocomplete="off"
                                /></h3>
                                <!-- Autocomplete dropdown -->
                                <div id="address-suggestions" class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg hidden max-h-60 overflow-y-auto">
                                </div>
                            </div> 
                        </div>
                    </div>

                    <!-- Browse Tab Content -->
                    <div id="browse-content" class="tab-content hidden">
                        <h3 class="text-lg font-medium text-gray-900 mb-4"></h3>
                        <div class="space-y-4 py-3 px-4">
                            <p class="text-gray-600">Coming soon: Browse locations on the map or search by category.</p>
                            <button
                                type="submit"
                                class="w-full py-3 px-4 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-colors"
                            >
                                Start Browsing
                            </button>
                        </div>
                    </div>
                </div>
            </div> 

            <div class="py-3 px-6 flex justify-center">
                <button
                    id="search-button"
                    onclick="performSearch()"
                    class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-3 px-6 border border-blue-700 rounded-lg text-lg">
                    <span id="search-text">Find My Representatives</span>
                    <span id="search-loading" class="hidden flex items-center justify-center">
                        <span class="mr-1">Searching</span>
                        <span class="animate-bounce">...</span>
                    </span>
                </button>
            </div>
            
            <!-- Search Results Container - Below Button -->
            <div id="search-results" class="w-full px-6 py-4 hidden">
                <div id="loading-message" class="text-center px-4 py-3 text-gray-500 text-sm hidden">
                    <span class="mr-1">Finding your representatives</span>
                    <span class="animate-pulse">...</span>
                </div>
                <div id="error-message" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md hidden">
                    <p class="font-medium">Unable to find representatives</p>
                    <p class="text-sm mt-1">Please check your address and try again.</p>
                </div>
                <div id="representatives-list" class="space-y-3 hidden">
                    <!-- Representatives will be populated here -->
                </div>
            </div>
        </div>
    </div>
</div>

